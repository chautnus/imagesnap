# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_CLIENT_ID: Your Google Cloud project Client ID
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# APP_URL: The URL where this applet is hosted.
# Railway: set to https://imagesnap.cloud
APP_URL="https://imagesnap.cloud"

# Lemon Squeezy Config
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_ID=

# Từ Google Cloud Console > OAuth Client (bắt buộc cho Authorization Code flow)
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
# 32-byte hex key để mã hoá refresh_token at-rest — sinh bằng:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_ENCRYPTION_KEY=generate_a_32_byte_hex_key
